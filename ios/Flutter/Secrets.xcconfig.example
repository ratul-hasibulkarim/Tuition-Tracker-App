// Copy to Secrets.xcconfig (git-ignored) and fill in your values. See README.

// Google Maps SDK key, restricted to this app's iOS bundle ID.
MAPS_API_KEY = your-ios-maps-key

// Google Sign-In (Drive backup). From the iOS OAuth client in Google Cloud:
GOOGLE_IOS_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
// The same ID reversed, e.g. com.googleusercontent.apps.1234567890-abc
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abc
// The "Web application" OAuth client ID (same one used on Android).
GOOGLE_SERVER_CLIENT_ID = 1234567890-web.apps.googleusercontent.com
